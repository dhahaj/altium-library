# Copy to .env, fill in, then: chmod 600 .env
# Passwords: 12+ chars, upper/lower/digit/symbol, and must NOT contain the login name (SQL Server policy).
# Avoid ' " $ and backtick in passwords; they get passed through sqlcmd and the shell.

# --- Local server ---
MSSQL_SA_PASSWORD=Sa-Root-Key-2026!
MSSQL_PID=Express            # Express = free, 10 GB per-database cap (plenty)
BIND_ADDR=0.0.0.0            # better: this host's LAN or Tailscale IP
DB_NAME=altium_library
MSSQL_MEMORY_LIMIT_MB=2048     # otherwise SQL Server grabs ~80% of the guest RAM

# Login Altium uses (read-only)
READER_USER=altium_reader
READER_PASSWORD=Ro-Parts-Key-2026!

# Login you edit parts with in DBeaver/SSMS (read/write, can create Custom tables)
LIBRARIAN_USER=librarian
LIBRARIAN_PASSWORD=Rw-Parts-Key-2026!

# Your own tables start with this prefix. The mirror never touches them.
CUSTOM_PREFIX="Custom - "

# --- Parts Manager web UI (./setup.sh ui) ---
# Login is user "admin" with this password (HTTP Basic). Required: the UI won't start without it.
PARTSUI_PASSWORD=
PARTSUI_PORT=8080
# Defaults to BIND_ADDR. Keep it on the LAN or Tailscale; never expose it to the internet.
#PARTSUI_BIND_ADDR=192.168.1.50
# Folders (inside the container) to scan for .SchLib/.PcbLib, colon-separated, for autocomplete.
# ./libs is mounted at /libs: git clone the Celestial repo to ./libs/celestial and your
# own libs repo to ./libs/daniel. Missing folders are skipped.
#PARTSUI_LIBS_DIRS=/libs/celestial:/libs/daniel

# --- Celestial source (from portal.altiumlibrary.com) ---
# Copy these from the connection string / UDL the portal gives you.
# The portal's Azure firewall rule must allow this host's public IP.
CELESTIAL_SERVER=your-server.database.windows.net
CELESTIAL_DATABASE=your-database
CELESTIAL_USER=your-user
CELESTIAL_PASSWORD=your-password
BATCH_SIZE=2000
